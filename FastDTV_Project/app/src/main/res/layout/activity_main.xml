<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- Superfície de renderização de Hardware para o sintonizador da TV -->
    <android.media.tv.TvView
        android:id="@+id/tvView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Mensagem de Boas-vindas / Nenhum Canal com Botão de Sintonia -->
    <LinearLayout
        android:id="@+id/emptyStateContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/glass_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📡 Nenhum Canal Encontrado"
            android:textColor="@color/text_white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Sua antena precisa fazer a busca automática para encontrar os canais da sua região."
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnEmptyScan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/accent_green"
                android:focusable="true"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp"
                android:text="🔍 Abrir Busca da Antena"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnEmptyRestore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:backgroundTint="#334155"
                android:focusable="true"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp"
                android:text="📡 Carregar Canais DTV"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Banner Rápido de Informações (Top Right) -->
    <LinearLayout
        android:id="@+id/channelBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="24dp"
        android:background="@color/glass_bg"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtBannerNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_green"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtBannerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/text_white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="#1A10B981"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="1080p FHD"
                android:textColor="@color/accent_green"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtBannerProg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Mini-Guia Lateral com Efeito Glassmorphism (Abre com Enter/OK) -->
    <LinearLayout
        android:id="@+id/quickGuide"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/glass_bg"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/channels_header"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Campo de Pesquisa de Canais -->
        <EditText
            android:id="@+id/edtSearchChannel"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="#1E293B"
            android:focusable="true"
            android:hint="🔍 Digite o canal ou número..."
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_secondary"
            android:textSize="14sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerChannels"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:focusable="true" />

        <!-- Botão de Sintonia no Guia -->
        <Button
            android:id="@+id/btnGuideScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#334155"
            android:focusable="true"
            android:text="📡 Fazer Nova Busca de Canais"
            android:textColor="@color/text_white"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnGuideRestore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:backgroundTint="#1E293B"
            android:focusable="true"
            android:text="⚡ Sincronizar Canais Digitais"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>
